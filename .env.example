# Alternativa manual a run_docker.ps1. Copia a .env y usa los datos del PostgreSQL existente.
IR_DOCKER_NETWORK=ir_network
DB_HOST=ir_postgres_postgis
DB_PORT=5432
DB_NAME=ir_promaster_db
DB_USER=casaco
DB_PASSWORD=

# Entorno local para conservar los flujos actuales de Flutter y recargas simuladas.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,10.0.2.2
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5353,http://127.0.0.1:5353
GOOGLE_MAPS_API_KEY=
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
CELERY_WORKER_CONCURRENCY=2
